# ---------------------------------------------------------------------------
# Core (REQUIRED — the app will not start without these)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/kandora-tournaments
# Public base URL of the app. The Discord OAuth redirect URI is
# APP_BASE_URL + /auth/discord/callback — register that exact URL in your
# Discord application. VITE_APP_BASE_URL (exposed to the browser) must match.
APP_BASE_URL=http://localhost:5173
VITE_APP_BASE_URL=http://localhost:5173
# Public web origin opened by the native shell for Discord login and lobby.
# Never use localhost here: inside Android it means the phone/emulator itself.
VITE_MOBILE_APP_BASE_URL=https://tournaments.example.com
JWT_SECRET=change-me-to-a-long-random-string

# Temporary deployment compatibility only. Leave false once both the web app
# and game-server support scoped game tokens.
GAME_ALLOW_LEGACY_AUTH_TOKENS=false

# Optional cross-subdomain sharing for the login session, locale, and theme.
# Set to a trusted parent domain like ".example.com" ONLY when another Kandora
# app is a sibling host and uses the SAME JWT_SECRET. Set the same value on all
# participating services. Leave unset for host-only sessions and preferences.
# AUTH_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Redis (BullMQ queues / scheduling). Enables the background-job subsystem —
# the league / scheduling / discord-sync workers only start when Redis is
# configured here; leave it unset for a web-only instance.
# Use REDIS_URL in production. Also accepts REDIS_URI / REDIS_PRIVATE_URL /
# REDIS_PRIVATE_URI / REDIS_PUBLIC_URL / REDIS_PUBLIC_URI, or discrete
# REDIS_HOST + REDIS_PORT. Set REDIS_TLS=true to force TLS without a rediss:// URL.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# REDIS_TLS=false

# ---------------------------------------------------------------------------
# Discord OAuth (login) + Bot. Create an app at
# https://discord.com/developers/applications
# VITE_DISCORD_CLIENT_ID is exposed to the browser (login button).
# ---------------------------------------------------------------------------
VITE_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# JSON array describing the Discord servers this instance manages, plus the
# role IDs that grant admin / editor permissions. Exactly one entry should set
# "isMain": true — its admin/editor roles govern app permissions.
# Example:
#   SERVERS_JSON=[{"id":"<guildId>","name":"My Club","isMain":true,"adminRoleId":"<roleId>","editorRoleId":"<roleId>","notificationChannelId":"<channelId>"}]
SERVERS_JSON=

# ---------------------------------------------------------------------------
# Game-platform connectors (optional). Set PLATFORM_CONNECTORS_DISABLED=true to
# force-disable all of them regardless of the values below.
# ---------------------------------------------------------------------------
PLATFORM_CONNECTORS_DISABLED=false
MAJSOUL_UID=
MAJSOUL_TOKEN=
MAJSOUL_FRIENDID=
RIICHICITY_EMAIL=
RIICHICITY_PASSWD=
RIICHICITY_GUID=
RIICHICITY_FRIENDID=
# Optional outbound HTTPS proxy for the Majsoul WebSocket connection.
# http_proxy=

# ---------------------------------------------------------------------------
# Translation (optional — DeepL auto-translation)
# ---------------------------------------------------------------------------
DEEPL_API_KEY=

# ---------------------------------------------------------------------------
# Nanikiru quiz (optional — the bot's mahjong quiz pulls questions from a
# Google Sheet). Requires a Google service-account JSON with read access.
# ---------------------------------------------------------------------------
NANIKIRU_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# In-app mahjong game (optional — off by default). Set GAME_ENABLED=true to
# expose the built-in game routes. VITE_PUBLIC_BASE_URL is baked into in-game
# share links at build time; set it to your public origin for prod/mobile builds.
# ---------------------------------------------------------------------------
# GAME_ENABLED=false
# VITE_PUBLIC_BASE_URL=
# Shared game-server used by Tenhou live spectating. GAME_SERVER_URL may be
# omitted when GAME_HTTP_URL or GAME_WS_URL already points to the same service.
# The same non-empty RELAY_SECRET must be configured on both services.
# GAME_SERVER_URL=http://localhost:8787
# GAME_WS_URL=ws://localhost:8787
# RELAY_SECRET=

# ---------------------------------------------------------------------------
# Workers — the league / scheduling / discord-sync BullMQ workers can run
# inline in the web process (true) or as separate processes
# (npm run worker:league / worker:scheduling). Defaults to inline in production.
# ---------------------------------------------------------------------------
ENABLE_INLINE_WORKER=false

# ---------------------------------------------------------------------------
# Uploads — directory for team / player pictures. In production point this at a
# mounted persistent volume.
# ---------------------------------------------------------------------------
# UPLOAD_DIR=.data/uploads

# Optional: port for the production server (react-router-serve; default 3000).
# PORT=3000

# Optional: mount the app under a sub-path (behind a shared reverse proxy).
# BASE_PATH=
